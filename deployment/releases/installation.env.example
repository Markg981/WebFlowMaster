# Copy to protected installation.env; replace every placeholder. Never commit real secrets.
DATABASE_URL=postgresql://app_user:REPLACE_PASSWORD@database.internal:5432/webflowmaster
MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE_PASSWORD@database.internal:5432/webflowmaster
REDIS_URL=redis://queue.internal:6379
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
AGENT_RELAY_SECRET=REPLACE_WITH_RANDOM_RELAY_SECRET
WEBFLOW_PUBLIC_URL=https://webflowmaster.example.com
APP_BASE_URL=https://application-under-test.example.com
