# The worker process: drains the BullMQ queue and runs test plans.
#
# Same base image as the web process, and for the same reason: a test plan runs its UI tests
# in a real browser, so the worker needs the browsers and their system libraries rather than
# just Node.
#
# The tag must equal the version the lockfile resolves for playwright — see the note in
# Dockerfile, and the architecture test that keeps the two from drifting apart again.
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /app

ENV NODE_ENV=production

# Dependencies first, and as their own layer: application code changes on every build,
# package-lock.json rarely.
#
# `--include=dev` is not optional here, whatever NODE_ENV says. The previous version ran
# `npm install --production` and then `npm run build`, which cannot work: the build needs
# esbuild and the TypeScript compiler, both dev dependencies, so it failed with exit 127 —
# `esbuild: not found`. Like the missing Dockerfile beside it, this had evidently never been
# built.
COPY package*.json ./
COPY client/package*.json ./client/
RUN npm ci --include=dev

COPY . .

# The root build script emits both entry points; the worker only needs dist/worker.js, but
# they are produced by one esbuild invocation. Dev dependencies go once it is done.
RUN npm run build && npm prune --omit=dev

# Lighthouse, for the auditLighthouse step (server/web-performance.ts). Installed as a program on
# its own rather than as a dependency of the application: it brings a browser driver and a
# telemetry SDK the application has no use for, and it runs as a separate process anyway. It uses
# the image's Playwright Chromium. Version 12 runs on any Node the image has; 13 needs 22.19.
RUN npm install -g --no-audit --no-fund lighthouse@12.8.2 && npm cache clean --force

CMD ["node", "dist/worker.js"]
