{
  // scripts/ used to sit outside every tsconfig project, so `npx tsc -b` could not see it.
  // Two live NOT NULL violations shipped through that gap when organizationId became a
  // required column: the importers compiled clean because nothing was compiling them.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo.scripts.json"
  },
  // Deliberately file-by-file rather than "**/*.ts", for two reasons:
  //
  //   - `../server/**/*.ts` would drag in every server test file. The inherited
  //     `**/*.test.ts` exclude is resolved relative to THIS directory, so it does not match
  //     anything reached through `../`. Naming ../server/platform/db.ts pulls in only its own
  //     (non-test) transitive imports.
  //
  // Project references would express the server/shared dependency better, but
  // tsconfig.base.json sets noEmit and a referenced project may not disable emit.
  // The root *.ts files are build configs (vite, vitest, drizzle, tailwind, playwright), which
  // tsc has no reason to typecheck as application code.
  "include": [
    "import-netcontent-api.ts",
    "apply-migrations.ts",
    "migrator-env.ts",
    "schema-doctor.ts",
    "wfm-load.ts",
    "netcontent/**/*.ts",
    "netcontent-ui/**/*.ts",
    "../server/platform/db.ts",
    // apply-migrations diagnoses the schema before touching it; same rule as db.ts — named
    // explicitly so only its own non-test imports come along.
    "../server/platform/schema-state.ts",
    // db.ts unwraps drizzle's query errors at startup.
    "../server/platform/db-errors.ts",
    // ...and sizes its pool from the environment.
    "../server/platform/db-pool-settings.ts",
    // ...and logs through the application logger, with what that formats lines with.
    "../server/platform/logger.ts",
    "../server/platform/loki-transport.ts",
    "../server/platform/middleware/correlation.ts",
    "../server/platform/utils/log-redactor.ts",
    // logger.ts and schema-state.ts find logs/ and migrations/ from the app root.
    "../server/platform/app-root.ts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
