{
  "realm": "acme",
  "displayName": "Acme (collaudo)",
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@acme.test",
    "fromDisplayName": "Acme"
  },
  "clients": [
    {
      "clientId": "webflowmaster",
      "name": "WebFlowMaster (collaudo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "collaudo-sso-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://wfm.collaudo.test/api/sso/callback"
      ],
      "webOrigins": [
        "https://wfm.collaudo.test"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups (casi SSO-18…)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api-client",
      "name": "OAuth 2.0 client credentials (caso API-04)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "collaudo-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "https://wfm.collaudo.test/api/sso/saml/1",
      "name": "WebFlowMaster SAML (casi SSO-13…)",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": false,
      "redirectUris": [
        "https://wfm.collaudo.test/api/sso/saml/1/acs"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "persistent",
        "saml_assertion_consumer_url_post": "https://wfm.collaudo.test/api/sso/saml/1/acs"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "config": {
            "attribute.name": "groups",
            "attribute.nameformat": "Basic",
            "full.path": "false",
            "single": "false"
          }
        }
      ]
    }
  ],
