# The secrets docker-compose.yml requires, for the collaudo stack only. Passed with
# --env-file collaudo/collaudo.env on every compose command of the stack (see README.md).
# They are public: never reuse them in an installation anyone else can reach.
#
# ENCRYPTION_KEY was the all-zero key of the base file until production started refusing it
# (server/startup-config.ts). A collaudo database filled before then holds secrets encrypted
# with that key: reset it (npm run collaudo:reset) and prepare it again.
POSTGRES_PASSWORD=password
SESSION_SECRET=collaudo-session-secret-not-for-production-0001
ENCRYPTION_KEY=c011a0d0c011a0d0c011a0d0c011a0d0c011a0d0c011a0d0c011a0d0c011a0d0
AGENT_RELAY_SECRET=collaudo-relay-secret-not-for-production
