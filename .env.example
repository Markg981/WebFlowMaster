# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (production) OR a local PGlite data directory path.
# Examples:
#   DATABASE_URL=postgres://user:password@localhost:5432/webflowmaster
#   DATABASE_URL=./data/local-pg
DATABASE_URL=./data/local-pg
# Postgres pool, per process (ignored by PGlite). Whole numbers; a timeout of 0 turns it off.
# PG_POOL_MAX=10
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ─── Redis (sessions, BullMQ queue/worker) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# Scheduler backend: "bullmq" (default: Redis-backed job schedulers, fired by the worker,
# once however many web processes there are, surviving restarts) or "cron" (in-process
# node-cron in the web process: every web process fires every schedule, so only for a
# single process with no worker, e.g. PGlite local development).
# SCHEDULER_BACKEND=bullmq

# ─── Security ────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# CSRF Origin check: comma-separated origins to trust in addition to the request Host.
# Only needed when the public origin differs from the internal Host behind a proxy,
# e.g. CSRF_TRUSTED_ORIGINS=https://app.example.com,https://www.example.com
# CSRF_TRUSTED_ORIGINS=

# Content Security Policy: enforce | report-only | off. Enforced in production by default.
# CONTENT_SECURITY_POLICY=

# Requests a minute per API key (and per address on /api/v1 without one), and per address on
# /api/webhooks. 0 turns a limit off.
# API_RATE_LIMIT=600
# WEBHOOK_RATE_LIMIT=120
# Sign-in attempts per 15 minutes for each client address.
# AUTH_RATE_LIMIT=20
# Requests a minute per signed-in user (per address without one) on the expensive routes:
# loading a page, detecting its elements, proxying an API request, starting a recording,
# asking the AI model. 0 turns it off.
# HEAVY_RATE_LIMIT=30
# Requests a minute per signed-in user on any /api route, far above what the UI needs.
# 0 turns it off.
# SESSION_RATE_LIMIT=1200

# "true" or "false": whether the session cookie is sent only over HTTPS. Default: true in
# production. "false" only for a local stack without TLS.
# SESSION_COOKIE_SECURE=true

# What a new password must be: "basic" (8 characters, not the username) or "strong" (12
# characters, three kinds of character, no username, no common passwords).
# PASSWORD_POLICY=basic

# "true": a single sign-on domain routes no sign-in until its organization has proven it with a
# DNS TXT record. Set it on every installation shared by several organizations.
# SSO_REQUIRE_DOMAIN_VERIFICATION=false

# The name the sidebar shows. Only read the first time the installation starts.
# WORKSPACE_NAME=WebFlowMaster

# Usernames who may change installation-wide settings (log level and retention, draining runners).
# Unset: the owners, while the installation has a single organization.
# INSTALLATION_ADMINS=

# ─── Billing ──────────────────────────────────────────────────────────────────
# none (default): the installation administrator puts organizations on plans and moves them
# between statuses by hand. stripe: owners pay through Stripe Checkout, and Stripe's webhook at
# POST /api/billing/webhooks/stripe moves the statuses; both STRIPE_* values are then required.
# Every organization starts on the seeded "free" plan, whose limits are the ORG_* defaults.
# BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the browser back after checkout or the portal; WEBFLOW_PUBLIC_URL when unset.
# BILLING_PUBLIC_BASE_URL=https://wfm.example.com
# How many days a past_due organization may still start runs before it is suspended (7).
# BILLING_PAST_DUE_GRACE_DAYS=7

# 32-byte (64 hex chars) key used to encrypt stored secrets (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-characters
# When ENCRYPTION_KEY is replaced: the keys it replaced, comma-separated, so what they encrypted
# still reads. Then `npm run key:rotate` moves everything to the new key and the list can go.
# ENCRYPTION_KEY_PREVIOUS=

# docker-compose.yml reads these two as well (with SESSION_SECRET and ENCRYPTION_KEY above) and
# refuses to start without them. In production the web process refuses every change-me value.
# POSTGRES_PASSWORD=
# AGENT_RELAY_SECRET=

# Who may create an account without an invitation. "invitation" (default): nobody, except the
# installation's very first account, which creates the first organization; everyone else joins
# through an invitation an owner sends from Settings > Members. "open": anyone who can reach the
# server may register and gets an organization of their own.
# REGISTRATION=invitation

# The name authenticator apps show beside a user's two-factor codes. Set it per installation
# (e.g. "WebFlowMaster Staging") so people with accounts on several can tell them apart.
# Default: WebFlowMaster
# MFA_ISSUER=WebFlowMaster

# ─── E-mail (optional) ───────────────────────────────────────────────────────
# The mail server, as smtp://user:password@host:587 (STARTTLS when offered) or smtps://…:465.
# With SMTP_FROM, turns on e-mail: invitations, reset links, "Forgot your password?" and run
# notifications. Organizations may configure their own SMTP in Settings; these are the defaults.
# SMTP_URL=
# SMTP_FROM=WebFlowMaster <qa@example.com>
# "false" accepts a relay with a self-signed certificate inside your network (installation
# defaults only; an organization's own SMTP always verifies certificates).
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# At least 32 characters: authenticates normalized delivery/bounce events posted to
# /api/mail-deliveries/events. Without it only SMTP acceptance/rejection is recorded.
# MAIL_DELIVERY_WEBHOOK_SECRET=

# ─── Running plans, and running them from CI ─────────────────────────────────
# The most browser sessions this installation will have open at once, whatever a
# test plan asks for. The plan's number is a statement about the suite; this one is
# a statement about the machine, and this one wins. Default: 16
# RUN_MAX_PARALLEL=4

# While it runs a plan, a worker writes a heartbeat every RUN_HEARTBEAT_INTERVAL_MS
# (default 15000). The web server ends a run whose heartbeat has been quiet for
# RUN_STALE_AFTER_MS (default 2 minutes) as "error: worker lost" — the worker died or
# was restarted — so reports and pipelines stop waiting for it. A run longer than
# RUN_MAX_DURATION_MS (default 3 hours) stops starting tests and ends "timed out".
# RUN_HEARTBEAT_INTERVAL_MS=15000
# RUN_STALE_AFTER_MS=120000
# RUN_MAX_DURATION_MS=10800000

# The largest response body an HTTP API test reads (default 50 MiB). Past it the transfer
# is cut off and the test fails, instead of the body filling the server's memory.
# API_RESPONSE_MAX_BYTES=52428800

# Each organization's share of the workers. At most ORG_MAX_CONCURRENT_RUNS of its runs
# are in progress at once (default 2); a run past that stays "queued", is looked at again
# every RUN_DEFERRAL_MS (default 10000) and starts as others finish. At most
# ORG_MAX_QUEUED_RUNS may wait (default 100); past that a new run is refused with 429.
# An organization's own limits, if set on its row, win over these. Among waiting runs, an
# organization with fewer in flight goes first, so one busy team cannot starve the rest.
# ORG_MAX_CONCURRENT_RUNS=2
# ORG_MAX_QUEUED_RUNS=100
# Quotas never require payment. Free/unlimited local use: TENANT_QUOTA_MODE=off.
# monitor measures without refusing operations; enforce applies configured limits (default).
# Use the same defaults on web/workers. Organization overrides win; null inherits.
# New dimensions default to 0 (unlimited); concurrency/queue limits stay positive integers.
# TENANT_QUOTA_MODE=off
# ORG_MAX_TESTS=0
# ORG_MAX_ARTIFACT_BYTES=0
# ORG_MAX_MONTHLY_EXECUTION_MINUTES=0
# RUN_DEFERRAL_MS=10000

# Each worker registers as a runner (Settings > Runners) and reports in every
# RUNNER_HEARTBEAT_INTERVAL_MS (default 15000); one not heard from for RUNNER_OFFLINE_AFTER_MS
# (default three intervals) shows as offline. APP_VERSION, if set, is the version it reports.
# RUNNER_HEARTBEAT_INTERVAL_MS=15000
# RUNNER_OFFLINE_AFTER_MS=45000
# APP_VERSION=

# How many plans one worker process runs at once. Default: 1. Raise it (or start more
# workers) for the per-organization limit above to matter.
# WORKER_CONCURRENCY=1

# How long a worker told to stop (SIGTERM) waits for the runs it has before exiting anyway.
# Default: 30000. A run can last hours; give it what it needs, and set the container's
# stop_grace_period to at least as much, or Docker kills the worker first.
# WORKER_SHUTDOWN_GRACE_MS=30000

# In a run shared by several workers: how often a worker confirms the tests it holds
# (default 15000), and how long a held test may go without a heartbeat before another
# worker takes it back (default 120000).
# WORK_ITEM_HEARTBEAT_MS=15000
# STALE_CLAIM_MS=120000

# Load tests (Load tests page): each run is a job on its own queue, executed by a worker.
# LOAD_WORKER_CONCURRENCY: load runs one worker executes at once; 0 means this worker takes
# none. Default: 1. The limits a run may ask for, and how many runs of one organization may
# be queued or running at once. Defaults: 200 virtual users, 3600 s, 1 run.
# LOAD_WORKER_CONCURRENCY=1
# LOAD_MAX_VIRTUAL_USERS=200
# LOAD_MAX_DURATION_S=3600
# LOAD_MAX_RUNS_PER_ORGANIZATION=1

# Where the browsers a person waits for run: a sequence preview, a single test run,
# loading a page or detecting its elements. "worker" (default) sends them to the worker
# process (npm run dev:worker), which is where plan runs already go, so a browser never
# weighs on the web server. "inline" keeps them in the web server — one process, fine
# for a laptop. Recording always runs in the web server: its window opens on that machine.
# BROWSER_TASKS=worker
# How many of those the worker runs at once, on a queue of their own so a long plan run
# never holds a preview up. Default: 2
# BROWSER_TASK_CONCURRENCY=2
# How long a request waits for one before answering 504. Default: 300000 (5 minutes)
# BROWSER_TASK_TIMEOUT_MS=300000
# The most elements one page detection returns; the result says when it was cut. Default: 300
# ELEMENT_DETECTION_LIMIT=300

# Where workers reach the agent relay in the web process, when they run on other machines or
# containers (e.g. http://api:5000). Default: http://127.0.0.1:<PORT>
# AGENT_RELAY_URL=
# With several web processes: this one's own address as the others reach it, so agents
# connected to one instance are usable from all.
# AGENT_RELAY_ADVERTISE_URL=

# How long a mobile inspector session may stay silent before the device session is closed and
# the grid released. Default: 300000 (5 minutes)
# MOBILE_INSPECTOR_IDLE_MS=300000

# The CLI (`npm run cli -- run <planId> --wait --junit junit.xml`, or `wfm` once
# built) reads these two from the environment, which is how a pipeline supplies
# them. They belong in the CI job, not on the server — listed here so the names are
# in one place. Create a key under Settings → API keys.
# WFM_URL=http://localhost:5000
# WFM_API_KEY=wfm_...
# Starts at most one run for this key: a retried pipeline step does not start a second run.
# WFM_IDEMPOTENCY_KEY=

# The local agent (wfm-agent) reads these on its own machine, with WFM_URL above: its token,
# shown once when an owner creates it, and how many browsers it lends at once (1 to 16).
# WFM_AGENT_TOKEN=wfa_...
# WFM_AGENT_MAX_SESSIONS=2

# ─── Notifications and visual testing ────────────────────────────────────────
# This installation's own address, used only to link back to a run from the
# notification a finished test plan sends. Deliberately separate from APP_BASE_URL,
# which points at the system under test: a notification about a failed run must not
# link to the application that run was testing. Unset means the notification carries
# the numbers without a link.
# WEBFLOW_PUBLIC_URL=http://localhost:5000

# Where the runners reach the demo shop the sample project tests (served at /demo-shop).
# WEBFLOW_PUBLIC_URL + /demo-shop when unset; set it when the workers reach this server by
# another address than its users.
# DEMO_SHOP_URL=http://wfm-api:5000/demo-shop

# Where visual baselines are kept between runs, with the local artifact store. They
# must outlive a single run, so this is not under results/. Default: ./data/visual-baselines
# VISUAL_BASELINE_DIR=./data/visual-baselines

# Where development and operations tools write their output: E2E reports, restore drill and
# resilience evidence, backups, scratch bundles. Not read by the server. Default: ./.local
# WFM_LOCAL_DIR=./.local

# ─── Artifact storage (screenshots, videos, traces, visual baselines) ─────────
# "local" (default) keeps them on this machine's disk, under results/ and the baseline
# directory above. "s3" keeps them in an S3-compatible bucket (AWS S3, MinIO, Cloudflare
# R2), which is what a worker on another machine, or several workers, need: the web
# server serves what any worker uploaded, and every worker compares against the same
# baselines. URLs in reports are the same with either store.
# ARTIFACT_STORE=local
# S3_BUCKET=webflowmaster-artifacts
# S3_REGION=us-east-1
# For MinIO, R2 or any self-hosted store; path-style addressing is on when this is set.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Unset means the AWS default chain (environment, profile, instance role).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Prepended to every key, so one bucket can hold several installations.
# S3_PREFIX=

# How many days a finished run keeps its screenshots, videos and traces, in either store.
# After that they are removed (the run, its results and its steps stay, and the report says
# the pictures were removed). Visual baselines are never removed. 0 keeps everything for ever.
# Default: 90
# ARTIFACT_RETENTION_DAYS=90

# ─── System under test ───────────────────────────────────────────────────────
# Resolves {{baseUrl}} in saved tests (API tests, UI tests and preconditions), so
# the same test runs against any environment without rewriting its URL.
#
# This is the fallback for a run with no environment selected. Prefer defining baseUrl
# per environment in Settings, which is what lets one test run against several sites.
# DMO_BASE_URL is still read, for installations that predate this name.
APP_BASE_URL=http://localhost:7000
# DMO_BASE_URL=

# The test inbox "Wait for email" steps read when the environment names none (mailpit.url),
# e.g. http://mailpit:8025, with basic authentication when it asks for it. On an installation
# shared by several companies leave it unset and let each environment name its own.
# MAILPIT_URL=
# MAILPIT_USERNAME=
# MAILPIT_PASSWORD=

# The Lighthouse program "Lighthouse audit" steps run (the Docker images include it; elsewhere
# npm install -g lighthouse@12), how long one audit may take, and the browser it audits in
# (default: Playwright's Chromium).
# LIGHTHOUSE_BIN=lighthouse
# LIGHTHOUSE_TIMEOUT_MS=120000
# CHROME_PATH=

# Hosts allowed to present a certificate Node would otherwise reject (typically a
# dev server with a self-signed certificate: DEPTH_ZERO_SELF_SIGNED_CERT).
# Comma-separated host:port — the exemption is per host, never global, and is
# ignored entirely when NODE_ENV=production.
# INSECURE_TLS_HOSTS=localhost:7000

# Where a test may make the server connect (the egress policy). Cloud metadata endpoints
# (169.254.0.0/16, fd00:ec2::254, metadata.google.internal, 100.100.100.200, 192.0.0.192,
# 168.63.129.16) are always refused. Private, loopback, link-local and unique-local addresses
# are reached by default, as a self-hosted installation testing its intranet expects; "deny"
# refuses them too, for an installation shared by several companies. Names are checked by
# what they resolve to, on every connection and every redirect. EGRESS_ALLOW_HOSTS exempts
# hostnames (*.suffix for a subtree) and CIDRs from both.
# EGRESS_PRIVATE_TARGETS=allow
# EGRESS_ALLOW_HOSTS=

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the API and the built client. Leave unset for 5000, which is what the Vite dev
# proxy assumes; a malformed value fails the boot rather than quietly binding 5000.
# When you change it, point the client dev server at the same place with VITE_API_PORT.
PORT=5000
# "production" in any real installation: secure cookies, JSON logs, closed diagnostic
# endpoints, no TLS exemptions. The npm scripts and docker-compose.yml set it themselves.
# NODE_ENV=production
# Development only: where the client dev server forwards API calls, when PORT is not 5000.
# VITE_API_PORT=5000

# ─── AI features (optional) ──────────────────────────────────────────────────
# Google Gemini API key; when unset, describing a test in sentences, AI selector healing and
# AI failure analysis are off, and nothing calls Google.
GEMINI_API_KEY=
# The model all three ask. Default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
# Another address for the same Gemini API: a proxy, or a test double such as the collaudo stack's.
# GEMINI_BASE_URL=
# How long a paused debug session waits for a command before it closes its browser.
# Default: 900000 (15 minutes)
# DEBUG_IDLE_TIMEOUT_MS=900000

# ─── Logging / Observability ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
# Initial level for the logs the web client sends to the server. Default: info
# CLIENT_LOG_LEVEL=info
# Optional Loki endpoint for centralized logs
LOKI_URL=http://localhost:3100

# Optional Prometheus listener. Disabled unless exactly "true"; token is mandatory.
# API defaults to 127.0.0.1:9464, worker to 127.0.0.1:9465. Set separately per process.
# WFM_METRICS_ENABLED=true
# WFM_METRICS_TOKEN=replace-with-a-long-random-token
# WFM_METRICS_HOST=127.0.0.1
# WFM_METRICS_PORT=9464
# Optional distributed tracing: W3C context over HTTP, queues and signed agent tickets.
# Enable on API, every worker and every agent that should export spans.
# WFM_TRACING_ENABLED=true
# WFM_TRACE_SAMPLE_RATIO=0.1
# OTEL_SERVICE_NAME=webflowmaster-api
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer%20collector-token
