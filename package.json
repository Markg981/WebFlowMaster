{
  "name": "webflowmaster",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --require dotenv/config server/index.ts",
    "dev:worker": "cross-env NODE_ENV=development tsx --require dotenv/config server/worker.ts",
    "import:netcontent": "cross-env tsx --require dotenv/config scripts/import-netcontent-api.ts",
    "build": "npm run build --workspace=client && npm run build:server && npm run build:migrator && npm run build:reset-link && npm run build:cli && npm run build:agent",
    "build:server": "esbuild server/index.ts server/worker.ts --platform=node --packages=external --external:./vite --bundle --format=esm --outdir=dist",
    "build:migrator": "esbuild scripts/apply-migrations.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/apply-migrations.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc -b && tsc -p collaudo/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p scripts/bdd-runtime.tsconfig.json",
    "db:push": "drizzle-kit push",
    "db:doctor": "tsx --require dotenv/config scripts/schema-doctor.ts",
    "backup:create": "tsx scripts/wfm-backup.ts create",
    "backup:verify": "tsx scripts/wfm-backup.ts verify",
    "backup:restore": "tsx scripts/wfm-backup.ts restore",
    "backup:drill": "tsx scripts/restore-drill.mjs",
    "test:restore-drill": "node --test scripts/restore-drill.test.mjs",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx --require dotenv/config scripts/apply-migrations.ts",
    "collaudo:up": "docker compose -p wfm-collaudo --env-file collaudo/collaudo.env -f docker-compose.yml -f collaudo/docker-compose.collaudo.yml up -d --build --wait",
    "collaudo:prepare": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prepare.mjs",
    "collaudo:check": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/check.mjs",
    "collaudo:simulatori": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-simulatori.mjs",
    "collaudo:carico": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-carico.mjs",
    "collaudo:scim": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-scim.mjs",
    "collaudo:protocolli": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-protocolli.mjs",
    "collaudo:protocolli:piani": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-piani-protocolli.mjs",
    "collaudo:sicurezza-mobile": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-sicurezza-mobile.mjs",
    "collaudo:mobile": "node collaudo/mobile/avvia.mjs",
    "collaudo:jenkins": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/jenkins/avvia.mjs",
    "collaudo:reset": "docker compose -p wfm-collaudo --env-file collaudo/collaudo.env -f docker-compose.yml -f collaudo/docker-compose.collaudo.yml down -v",
    "test:migrate": "tsx server/tests/setup.ts",
    "test": "vitest run && vitest run --config scripts/bdd-runtime.vitest.config.ts",
    "test:rls": "npm run test:rls:base && npm run test:rls:collaboration && npm run test:rls:email && npm run test:rls:bdd && npm run test:rls:authoring",
    "test:rls:authoring": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/api-v1/authoring.test.ts server/routes/api-v1.routes.test.ts",
    "test:rls:bdd": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/bdd-isolation.test.ts server/routes/bdd.routes.test.ts server/routes/bdd-tests.test.ts server/bdd-execution.test.ts",
    "test:rls:email": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/organization-mail-isolation.test.ts server/routes/mail-settings.routes.test.ts server/routes/mail-templates.routes.test.ts server/routes/mail-provider.routes.test.ts",
    "test:rls:base": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/isolation.test.ts server/tests/typed-version-isolation.test.ts server/middleware/tenancy.test.ts server/middleware/tenancy-reentrancy.test.ts server/audit.test.ts",
    "test:rls:collaboration": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/collaboration-isolation.test.ts server/routes/comments.routes.test.ts server/routes/dashboards.routes.test.ts server/routes/analytics.routes.test.ts",
    "test:ui": "vitest --ui",
    "install-client": "npm install --prefix client",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "test:client": "npm test --prefix client",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "docs:pdf": "npm run docs:build && node scripts/generate-docs-pdf.js",
    "docs:dev": "vitepress dev docs",
    "dev:docs": "npm run docs:dev",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx --require dotenv/config scripts/wfm-cli.ts",
    "load": "tsx scripts/wfm-load.ts",
    "load:resilience": "node scripts/wfm-resilience.mjs",
    "test:resilience": "node --test scripts/resilience-core.test.mjs",
    "build:cli": "esbuild scripts/wfm-cli.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wfm.js",
    "build:agent": "esbuild scripts/wfm-agent.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wfm-agent.js && esbuild scripts/bdd-child.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wfm-bdd-child.mjs",
    "agent": "tsx --require dotenv/config scripts/wfm-agent.ts",
    "user:reset-link": "tsx --require dotenv/config scripts/password-reset-link.ts",
    "build:reset-link": "esbuild scripts/password-reset-link.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/password-reset-link.js",
    "dev:collaudo": "node collaudo/app/server.mjs",
    "test:collaudo": "node --test collaudo/app/server.test.mjs",
    "test:collaudo:browser": "node --test collaudo/app/browser.test.mjs",
    "test:network:unit": "node --test deployment/saas-network/policy.test.mjs deployment/saas-network/wait-worker.test.mjs",
    "test:network": "node deployment/saas-network/network-check.mjs",
    "test:network:production": "node deployment/saas-network/production-check.mjs",
    "build:network-probe": "esbuild scripts/check-saas-transports.ts --platform=node --packages=external --bundle --format=esm --outfile=tmp/saas-transports.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:security": "node --test scripts/security/*.test.mjs",
    "test:matrix:certify": "playwright test --config=e2e/matrix-certification.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/gherkin": "38.0.0",
    "@cucumber/messages": "32.3.1",
    "@electric-sql/pglite": "^0.4.5",
    "@google/generative-ai": "^0.24.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@playwright/test": "1.63.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pngjs": "^6.0.5",
    "@types/uuid": "^10.0.0",
    "@xmldom/xmldom": "^0.8.15",
    "axe-core": "^4.13.0",
    "bullmq": "^5.76.4",
    "connect-pg-simple": "^10.0.0",
    "connect-redis": "^9.0.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.7.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "fs-extra": "^11.3.0",
    "helmet": "^8.2.0",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.10.1",
    "memorystore": "^1.6.7",
    "mssql": "^12.7.2",
    "multer": "^2.0.2",
    "mysql2": "^3.24.5",
    "node-cron": "^4.1.1",
    "nodemailer": "10.0.15",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.1.0",
    "sanitize-html": "^2.18.0",
    "undici": "6.29.0",
    "unpdf": "^1.2.2",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.18.0",
    "xml-crypto": "^6.3.2",
    "xpath": "^0.0.34",
    "yaml": "^2.9.1",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.1.5",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mssql": "^12.3.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "allure-commandline": "^2.36.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.2.0",
    "mermaid": "^11.17.2",
    "node-html-parser": "^9.0.0",
    "prettier": "^3.9.4",
    "supertest": "^7.1.1",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "zod": "3.25.76",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "vite": "6.4.4",
    "tedious": "20.3.6"
  },
  "workspaces": [
    "client"
  ],
  "bin": {
    "wfm": "dist/wfm.js"
  }
}
