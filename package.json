{
  "name": "webflowmaster",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --require dotenv/config server/index.ts",
    "dev:worker": "cross-env NODE_ENV=development tsx --require dotenv/config server/worker.ts",
    "import:netcontent": "cross-env tsx --require dotenv/config scripts/import-netcontent-api.ts",
    "build": "npm run build --workspace=client && npm run build:server && npm run build:migrator && npm run build:reset-link && npm run build:cli && npm run build:agent && npm run build:docs",
    "build:docs": "cross-env WFM_DOCS_BASE=/docs/ WFM_DOCS_OUT_DIR=../dist/docs vitepress build docs",
    "build:server": "esbuild server/index.ts server/worker.ts --platform=node --packages=external --external:./vite --bundle --format=esm --outdir=dist",
    "build:migrator": "esbuild scripts/apply-migrations.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/apply-migrations.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc -b && tsc -p collaudo/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p scripts/bdd-runtime.tsconfig.json",
    "db:push": "drizzle-kit push",
    "db:doctor": "tsx --require dotenv/config scripts/schema-doctor.ts",
    "backup:create": "tsx scripts/wfm-backup.ts create",
    "backup:verify": "tsx scripts/wfm-backup.ts verify",
    "backup:restore": "tsx scripts/wfm-backup.ts restore",
    "backup:drill": "tsx scripts/restore-drill.mjs",
    "test:restore-drill": "node --test scripts/restore-drill.test.mjs",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx --require dotenv/config scripts/apply-migrations.ts",
    "key:rotate": "tsx --require dotenv/config scripts/wfm-rotate-key.ts",
    "collaudo:up": "docker compose -p wfm-collaudo --env-file collaudo/collaudo.env -f docker-compose.yml -f collaudo/docker-compose.collaudo.yml up -d --build --wait",
    "collaudo:prepare": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prepare.mjs",
    "collaudo:check": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/check.mjs",
    "collaudo:simulatori": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-simulatori.mjs",
    "collaudo:carico": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-carico.mjs",
    "collaudo:scim": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-scim.mjs",
    "collaudo:protocolli": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-protocolli.mjs",
    "collaudo:protocolli:piani": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-piani-protocolli.mjs",
    "collaudo:sicurezza-mobile": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/prova-sicurezza-mobile.mjs",
    "collaudo:mobile": "node collaudo/mobile/avvia.mjs",
    "collaudo:jenkins": "cross-env NODE_EXTRA_CA_CERTS=collaudo/collaudo-root.crt node collaudo/jenkins/avvia.mjs",
    "collaudo:reset": "docker compose -p wfm-collaudo --env-file collaudo/collaudo.env -f docker-compose.yml -f collaudo/docker-compose.collaudo.yml down -v",
    "test:migrate": "tsx server/tests/setup.ts",
    "test": "vitest run && vitest run --config scripts/bdd-runtime.vitest.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config scripts/bdd-runtime.vitest.config.ts",
    "test:rls": "npm run test:rls:base && npm run test:rls:collaboration && npm run test:rls:email && npm run test:rls:bdd && npm run test:rls:authoring && npm run test:rls:execution",
    "test:rls:authoring": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/http/api-v1/authoring.test.ts server/http/routes/api-v1.routes.test.ts",
    "test:rls:bdd": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/bdd-isolation.test.ts server/http/routes/bdd.routes.test.ts server/http/routes/bdd-tests.test.ts server/bdd/bdd-execution.test.ts",
    "test:rls:email": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/organization-mail-isolation.test.ts server/http/routes/mail-settings.routes.test.ts server/http/routes/mail-templates.routes.test.ts server/http/routes/mail-provider.routes.test.ts",
    "test:rls:base": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/isolation.test.ts server/tests/typed-version-isolation.test.ts server/platform/middleware/tenancy.test.ts server/platform/middleware/tenancy-reentrancy.test.ts server/tenancy/audit.test.ts",
    "test:rls:collaboration": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/collaboration-isolation.test.ts server/http/routes/comments.routes.test.ts server/http/routes/dashboards.routes.test.ts server/http/routes/analytics.routes.test.ts",
    "test:rls:execution": "cross-env WFM_TEST_REQUIRE_POSTGRES=1 vitest run --no-file-parallelism server/tests/execution-unit-isolation.test.ts",
    "test:ui": "vitest --ui",
    "install-client": "npm install --prefix client",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "test:client": "npm test --prefix client",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "docs:pdf": "npm run docs:build && node scripts/generate-docs-pdf.js",
    "docs:dev": "vitepress dev docs",
    "dev:docs": "npm run docs:dev",
    "docs:build": "vitepress build docs",
    "docs:schema-catalog": "node scripts/generate-schema-catalog.mjs",
    "docs:api-reference": "tsx scripts/generate-api-reference.ts",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "marketing:refresh": "node marketing/refresh.mjs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "any-budget": "node scripts/any-budget.mjs",
    "deps:check": "node scripts/deps-check.mjs",
    "deps:baseline": "depcruise-baseline server shared --config .dependency-cruiser.mjs --output-to .dependency-cruiser-known-violations.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx --require dotenv/config scripts/wfm-cli.ts",
    "load": "tsx scripts/wfm-load.ts",
    "volume": "tsx scripts/wfm-volume.ts",
    "load:resilience": "node scripts/wfm-resilience.mjs",
    "test:resilience": "node --test scripts/resilience-core.test.mjs",
    "benchmark": "node --import tsx scripts/wfm-benchmark.mjs",
    "test:benchmark": "node --test scripts/benchmark-config.test.mjs",
    "pilot": "node scripts/wfm-pilot.mjs",
    "test:pilot": "node --test scripts/pilot.test.mjs",
    "build:cli": "esbuild scripts/wfm-cli.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wfm.js",
    "build:agent": "esbuild scripts/wfm-agent.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wfm-agent.js && esbuild scripts/bdd-child.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wfm-bdd-child.mjs",
    "agent": "tsx --require dotenv/config scripts/wfm-agent.ts",
    "user:reset-link": "tsx --require dotenv/config scripts/password-reset-link.ts",
    "build:reset-link": "esbuild scripts/password-reset-link.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/password-reset-link.js",
    "dev:collaudo": "node collaudo/app/server.mjs",
    "test:collaudo": "node --test collaudo/app/server.test.mjs",
    "fixture:shadow": "tsx -e \"import('./e2e/recorder-shadow-fixture.ts').then((m) => m.startShadowFixture(5090)).then((f) => console.log('Web component fixture on ' + f.baseUrl))\"",
    "test:collaudo:browser": "node --test collaudo/app/browser.test.mjs",
    "test:network:unit": "node --test deployment/saas-network/policy.test.mjs deployment/saas-network/wait-worker.test.mjs",
    "test:helm": "node --test scripts/helm-chart.test.mjs",
    "test:network": "node deployment/saas-network/network-check.mjs",
    "test:network:production": "node deployment/saas-network/production-check.mjs",
    "build:network-probe": "esbuild scripts/check-saas-transports.ts --platform=node --packages=external --bundle --format=esm --outfile=.local/tmp/saas-transports.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "changelog:draft": "node scripts/release/changelog.mjs draft",
    "changelog:release": "node scripts/release/changelog.mjs release",
    "test:security": "node --test scripts/security/*.test.mjs",
    "test:matrix:certify": "playwright test --config=e2e/matrix-certification.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "32.3.1",
    "@electric-sql/pglite": "^0.4.5",
    "@google/generative-ai": "^0.24.1",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@xmldom/xmldom": "^0.8.15",
    "axe-core": "^4.14.0",
    "bullmq": "^5.76.4",
    "connect-redis": "^10.0.0",
    "cron-parser": "^5.10.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "fs-extra": "^11.4.1",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.10.1",
    "memorystore": "^1.6.8",
    "mssql": "^12.7.9",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "10.1.2",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.1",
    "undici": "6.29.1",
    "unpdf": "^1.9.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.22.0",
    "xml-crypto": "^6.4.0",
    "xpath": "^0.0.35",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.1.5",
    "@playwright/test": "1.63.0",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.3.0",
    "@types/node": "20.16.11",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.11",
    "allure-commandline": "^2.46.1",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^18.6.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "mermaid": "^11.17.2",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  },
  "overrides": {
    "zod": "4.6.7",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "vite": "6.4.4",
    "tedious": "20.3.6",
    "@azure/msal-node": "^7.1.0",
    "dompurify": "3.4.17",
    "express": {
      "body-parser": "1.20.9"
    }
  },
  "workspaces": [
    "client"
  ],
  "bin": {
    "wfm": "dist/wfm.js"
  }
}
