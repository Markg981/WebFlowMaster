# The local agent: runs inside a customer's network and lends its browsers to the server
# (scripts/wfm-agent.ts, server/agents/relay.ts). It only connects out, to WFM_URL.
#
#   docker build -f Dockerfile.agent -t webflowmaster-agent .
#   docker run -d --restart unless-stopped \
#     -e WFM_URL=https://webflowmaster.example.com -e WFM_AGENT_TOKEN=wfa_… webflowmaster-agent
#
# The tag must equal the version the lockfile resolves for playwright, like the other images:
# the server refuses an agent whose Playwright major.minor differs from its own, because the
# protocol between the two changes between minors.
FROM mcr.microsoft.com/playwright:v1.61.1-jammy AS build

WORKDIR /src
COPY package*.json ./
COPY client/package*.json ./client/
RUN npm ci --include=dev
COPY . .
RUN npm run build:agent

FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /agent
ENV NODE_ENV=production

# Only for testing the server's refusal of a mismatched agent (collaudo AGT-05): an agent on
# another Playwright version, whose browsers the image does not have. Empty in every real build.
ARG PLAYWRIGHT_VERSION=

# The agent is one bundled file; native API protocols also need the gRPC packages.
# The playwright library is installed at exactly the resolved version, never a range: the
# image's browsers are built for that version and no other.
COPY --from=build /src/node_modules/playwright/package.json /tmp/playwright-package.json
COPY --from=build /src/node_modules/@grpc/grpc-js/package.json /tmp/grpc-package.json
COPY --from=build /src/node_modules/@grpc/proto-loader/package.json /tmp/proto-package.json
COPY --from=build /src/node_modules/undici/package.json /tmp/undici-package.json
COPY --from=build /src/node_modules/https-proxy-agent/package.json /tmp/proxy-package.json
COPY --from=build /src/node_modules/zod/package.json /tmp/zod-package.json
COPY --from=build /src/node_modules/@cucumber/cucumber/package.json /tmp/cucumber-package.json
COPY --from=build /src/node_modules/@cucumber/gherkin/package.json /tmp/gherkin-package.json
COPY --from=build /src/node_modules/@cucumber/messages/package.json /tmp/messages-package.json
COPY --from=build /src/node_modules/tsx/package.json /tmp/tsx-package.json
RUN npm init -y >/dev/null \
  && npm install --omit=dev "playwright@${PLAYWRIGHT_VERSION:-$(node -p "require('/tmp/playwright-package.json').version")}" "ws@^8.18.0" \
     "@grpc/grpc-js@$(node -p "require('/tmp/grpc-package.json').version")" \
     "@grpc/proto-loader@$(node -p "require('/tmp/proto-package.json').version")" \
     "undici@$(node -p "require('/tmp/undici-package.json').version")" \
     "https-proxy-agent@$(node -p "require('/tmp/proxy-package.json').version")" \
     "zod@$(node -p "require('/tmp/zod-package.json').version")" \
     "@cucumber/cucumber@$(node -p "require('/tmp/cucumber-package.json').version")" \
     "@cucumber/gherkin@$(node -p "require('/tmp/gherkin-package.json').version")" \
     "@cucumber/messages@$(node -p "require('/tmp/messages-package.json').version")" \
     "tsx@$(node -p "require('/tmp/tsx-package.json').version")" \
  && rm /tmp/playwright-package.json /tmp/grpc-package.json /tmp/proto-package.json /tmp/undici-package.json /tmp/proxy-package.json /tmp/zod-package.json
COPY --from=build /src/dist/wfm-agent.js ./wfm-agent.mjs
COPY --from=build /src/dist/wfm-bdd-child.mjs ./wfm-bdd-child.mjs

# Lets the running sessions finish on `docker stop`.
STOPSIGNAL SIGTERM
USER pwuser
CMD ["node", "wfm-agent.mjs"]
