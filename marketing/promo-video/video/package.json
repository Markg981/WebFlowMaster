{
  "name": "webflowmaster-promo-video",
  "private": true,
  "description": "The WebFlowMaster promo video, written with Remotion: 60, 30 and 15 seconds, in 16:9, 1:1 and 9:16.",
  "scripts": {
    "studio": "remotion studio",
    "audio:generate": "node ../audio/synthesize.mjs",
    "voice": "node ../audio/narrate.mjs",
    "captions": "node ../audio/captions.mjs",
    "render": "node ../render.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "lucide-react": "^1.48.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
